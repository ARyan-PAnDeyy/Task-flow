NODE_ENV=development
PORT=5000

# Database: "sqlite" (zero-setup local dev) or "postgres"
DB_DIALECT=sqlite
SQLITE_STORAGE=./data/dev.sqlite
# Used when DB_DIALECT=postgres (either DATABASE_URL or the individual vars)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskflow
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Seeded admin account (created on first start if no admin exists)
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@taskflow.com
ADMIN_PASSWORD=Admin@123

# Load demo users/projects/tasks on first boot when the database is empty
SEED_DEMO=false
