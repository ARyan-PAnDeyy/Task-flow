{
  "info": {
    "name": "TaskFlow - Project & Task Management API",
    "description": "Run \"Auth > Login (Admin)\" first: the token is saved to {{token}} and used by every request.\nLogin (Manager) / Login (Member) overwrite {{token}} so you can try role-based access.\nCreate requests save the new id ({{projectId}}, {{taskId}}, ...) for the following requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "projectId",
      "value": "1"
    },
    {
      "key": "taskId",
      "value": "1"
    },
    {
      "key": "commentId",
      "value": "1"
    },
    {
      "key": "attachmentId",
      "value": "1"
    },
    {
      "key": "userId",
      "value": "4"
    }
  ],
