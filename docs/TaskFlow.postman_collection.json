            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane.{{$timestamp}}@example.com\",\n  \"password\": \"Secret@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
